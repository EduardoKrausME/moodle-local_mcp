# Apache 2.4+: append these rules to the existing Moodle document-root
# .htaccess (before Moodle catch-all/rewrite rules). Do not replace the
# Moodle core .htaccess: Moodle may already have essential security rules.
# Requires mod_rewrite and AllowOverride FileInfo (or All).
# Do not install this file inside local/mcp: requests to /.well-known/ never
# traverse that directory.
# Nginx ignores .htaccess; configure location/rewrite in the server block.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Authorization server metadata (RFC 8414) and OpenID fallback.
    RewriteRule ^\.well-known/(oauth-authorization-server|openid-configuration)(/local/mcp(/(server|read|write)\.php)?)?/?$ local/mcp/oauth-metadata.php [END,QSA]

    # OAuth protected resource metadata (RFC 9728).
    RewriteRule ^\.well-known/oauth-protected-resource(/local/mcp(/(server|read|write)\.php)?)?/?$ local/mcp/oauth-resource.php [END,QSA]

    # Some MCP clients try this exact fallback based on the server URL.
    RewriteRule ^local/mcp/(server|read|write)\.php/\.well-known/(oauth-authorization-server|openid-configuration)/?$ local/mcp/oauth-metadata.php [END,QSA]

    # Optional compatibility for local plugin well-known discovery.
    RewriteRule ^local/mcp/\.well-known/(oauth-authorization-server|openid-configuration)(\.php)?/?$ local/mcp/oauth-metadata.php [END,QSA]
    RewriteRule ^local/mcp/\.well-known/oauth-protected-resource(\.php)?/?$ local/mcp/oauth-resource.php [END,QSA]
</IfModule>
