# Apache 2.4 MCP OAuth and OpenID metadata discovery.
# Installed in Moodle/local/mcp/.htaccess (the root of this plugin).
# Requires mod_rewrite and AllowOverride FileInfo/All.
# Nginx DOES NOT read .htaccess.
#
# IMPORTANT: Only paths under /local/mcp can be intercepted here.
# The host-root /.well-known URLs require web-server-level rewriting.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Clients may append discovery paths to the PHP entrypoint.
    # Preserve REQUEST_URI for the precise RFC 8414 issuer.
    RewriteRule ^(server|read|write)\.php/\.well-known/(oauth-authorization-server|openid-configuration)/?$ oauth-metadata.php [END,QSA]

    # Discover auth-server metadata below this plugin (including legacy paths).
    RewriteRule ^\.well-known/(oauth-authorization-server|openid-configuration)(\.php)?/?$ oauth-metadata.php [END,QSA]
    RewriteRule ^\.well-known/(oauth-authorization-server|openid-configuration)/local/mcp(/(server|read|write)\.php)?/?$ oauth-metadata.php [END,QSA]

    # Discover protected-resource metadata below this plugin.
    RewriteRule ^\.well-known/oauth-protected-resource(\.php)?/?$ oauth-resource.php [END,QSA]
    RewriteRule ^\.well-known/oauth-protected-resource/local/mcp(/(server|read|write)\.php)?/?$ oauth-resource.php [END,QSA]
</IfModule>
