{{!
    @template local_mcp/authorization_consent

    Accessible, responsive OAuth consent screen.

    Example context (json):
    {
        "clientname": "ChatGPT",
        "origin": "https://callback.example.org",
        "redirecturi": "https://callback.example.org/oauth/callback",
        "unverified": true,
        "sitename": "Example Moodle",
        "sitedomain": "moodle.example.org",
        "read": true,
        "write": true,
        "date": "11 October 2026",
        "action": "/local/mcp/oauth/authorize.php",
        "sesskey": "example"
    }
}}
<div class="local-mcp-consent">
    <section class="local-mcp-consent__panel" aria-labelledby="mcp-consent-title">
        <header class="local-mcp-consent__hero">
            <div class="local-mcp-consent__hero-top">
                <span class="local-mcp-consent__symbol" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                         stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                </span>
                <span class="local-mcp-consent__overline">{{#str}}oauthconsenteyebrow, local_mcp{{/str}}</span>
                <span class="local-mcp-consent__protocol">OAuth 2.1</span>
            </div>
            <h2 id="mcp-consent-title" class="local-mcp-consent__title">
                {{#str}}oauthconsenttitle, local_mcp{{/str}}
            </h2>
            <p class="local-mcp-consent__subtitle">
                {{#str}}authorizeintro, local_mcp, {{clientname}}{{/str}}
            </p>
        </header>

        <div class="local-mcp-consent__content">
            <div class="local-mcp-consent__connection"
                 aria-label="{{#str}}oauthconsentconnection, local_mcp{{/str}}">
                <div class="local-mcp-consent__identity">
                    <span class="local-mcp-consent__identity-icon local-mcp-consent__identity-icon--app"
                          aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round" focusable="false">
                            <rect x="3.5" y="3.5" width="7" height="7" rx="2"/>
                            <rect x="13.5" y="3.5" width="7" height="7" rx="2"/>
                            <rect x="3.5" y="13.5" width="7" height="7" rx="2"/>
                            <rect x="13.5" y="13.5" width="7" height="7" rx="2"/>
                        </svg>
                    </span>
                    <div class="local-mcp-consent__identity-text">
                        <span class="local-mcp-consent__identity-caption">
                            {{#str}}oauthconsentapplication, local_mcp{{/str}}
                        </span>
                        <strong class="local-mcp-consent__identity-name">{{clientname}}</strong>
                        {{#origin}}
                            <span class="local-mcp-consent__identity-meta">{{origin}}</span>
                        {{/origin}}
                    </div>
                </div>

                <span class="local-mcp-consent__connection-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <path d="M4 12h16m-6-6 6 6-6 6"/>
                    </svg>
                </span>

                <div class="local-mcp-consent__identity">
                    <span class="local-mcp-consent__identity-icon local-mcp-consent__identity-icon--moodle"
                          aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round" focusable="false">
                            <path d="M12 5c-3.5-2-6.5-2-9-1v14c3-.8 6-.6 9 1 3-1.6 6-1.8 9-1V4c-2.5-1-5.5-1-9 1Z"/>
                            <path d="M12 5v14"/>
                        </svg>
                    </span>
                    <div class="local-mcp-consent__identity-text">
                        <span class="local-mcp-consent__identity-caption">
                            {{#str}}oauthconsentdestination, local_mcp{{/str}}
                        </span>
                        <strong class="local-mcp-consent__identity-name">{{sitename}}</strong>
                        <span class="local-mcp-consent__identity-meta">{{sitedomain}}</span>
                    </div>
                </div>
            </div>

            <div class="local-mcp-consent__redirect">
                <strong>{{#str}}oauthconsentredirecturi, local_mcp{{/str}}</strong>
                <code>{{redirecturi}}</code>
            </div>

            {{#unverified}}
                <div class="local-mcp-consent__unverified" role="note">
                    <strong>{{#str}}oauthconsentunverifiedtitle, local_mcp{{/str}}</strong>
                    <p>{{#str}}oauthconsentunverifiedbody, local_mcp{{/str}}</p>
                </div>
            {{/unverified}}

            <div class="local-mcp-consent__permissions-heading">
                <h3>{{#str}}oauthconsentpermissions, local_mcp{{/str}}</h3>
                <p>{{#str}}oauthconsentpermissionsintro, local_mcp{{/str}}</p>
            </div>

            <div class="local-mcp-consent__permissions">
                {{#read}}
                    <div class="local-mcp-consent__permission local-mcp-consent__permission--read">
                        <span class="local-mcp-consent__permission-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                                 stroke-linecap="round" stroke-linejoin="round" focusable="false">
                                <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </span>
                        <div class="local-mcp-consent__permission-details">
                            <div class="local-mcp-consent__permission-head">
                                <h4>{{#str}}readpermissions, local_mcp{{/str}}</h4>
                                <span class="local-mcp-consent__tag local-mcp-consent__tag--read">READ</span>
                            </div>
                            <p>{{#str}}oauthconsentreadsummary, local_mcp{{/str}}</p>
                        </div>
                    </div>
                {{/read}}
                {{#write}}
                    <div class="local-mcp-consent__permission local-mcp-consent__permission--write">
                        <span class="local-mcp-consent__permission-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                                 stroke-linecap="round" stroke-linejoin="round" focusable="false">
                                <path d="m15 5 4 4M4 20l4.5-1 11-11a2.8 2.8 0 0 0-4-4l-11 11L4 20Z"/>
                                <path d="M4 20h16"/>
                            </svg>
                        </span>
                        <div class="local-mcp-consent__permission-details">
                            <div class="local-mcp-consent__permission-head">
                                <h4>{{#str}}writepermissions, local_mcp{{/str}}</h4>
                                <span class="local-mcp-consent__tag local-mcp-consent__tag--write">WRITE</span>
                            </div>
                            <p>{{#str}}oauthconsentwritesummary, local_mcp{{/str}}</p>
                        </div>
                    </div>
                {{/write}}
            </div>

            <div class="local-mcp-consent__notice" role="note">
                <span class="local-mcp-consent__notice-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M12 11v5m0-8h.01"/>
                    </svg>
                </span>
                <div>
                    <strong>{{#str}}oauthconsentsecuritytitle, local_mcp{{/str}}</strong>
                    <p>{{#str}}oauthconsentsecuritybody, local_mcp{{/str}}</p>
                </div>
            </div>
        </div>

        <footer class="local-mcp-consent__footer">
            <form method="post" action="{{action}}" class="local-mcp-consent__form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="local-mcp-consent__actions">
                    <button class="local-mcp-consent__button local-mcp-consent__button--cancel"
                            type="submit" name="decision" value="cancel">
                        {{#str}}cancel, local_mcp{{/str}}
                    </button>
                    <button class="local-mcp-consent__button local-mcp-consent__button--approve"
                            type="submit" name="decision" value="authorize">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                             focusable="false">
                            <path d="m5 12 4.5 4.5L19 7"/>
                        </svg>
                        {{#str}}authorize, local_mcp{{/str}}
                    </button>
                </div>
                <p class="local-mcp-consent__footer-note">
                    {{#str}}oauthconsentfooter, local_mcp{{/str}}
                </p>
            </form>
        </footer>
    </section>
</div>
