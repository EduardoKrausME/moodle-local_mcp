{{!
    @template local_mcp/new_connection

    Example context (json):
    {
        "serverurl": "https://moodle.example/local/mcp/server.php",
        "httpsdisabled": false
    }
}}
<section class="card border-0 shadow-sm p-4 my-4" aria-labelledby="mcp-new-connection-title">
    <h2 id="mcp-new-connection-title">{{#str}}newconnectiontitle, local_mcp{{/str}}</h2>
    <p>{{#str}}newconnectionintro, local_mcp{{/str}}</p>
    {{#httpsdisabled}}
        <p class="alert alert-warning" role="alert">{{#str}}chatgptsetuphttpsdisabled, local_mcp{{/str}}</p>
    {{/httpsdisabled}}
    <div class="mb-4">
        <label for="mcp-new-connection-url" class="form-label">
            {{#str}}chatgptsetupserverlabel, local_mcp{{/str}}
        </label>
        <input id="mcp-new-connection-url" class="form-control" type="text"
               value="{{serverurl}}" readonly spellcheck="false">
        <p class="form-text">{{#str}}newconnectionurlhelp, local_mcp{{/str}}</p>
    </div>
    <div class="mb-4">
        <h3>{{#str}}connectionguidechatgptstarttitle, local_mcp{{/str}}</h3>
        <ol>
            <li>{{#str}}chatgptsetupstep2body, local_mcp{{/str}}</li>
            <li>{{#str}}chatgptsetupstep4body, local_mcp{{/str}}</li>
            <li>{{#str}}chatgptsetupstep5body, local_mcp{{/str}}</li>
        </ol>
        <a href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer">
            {{#str}}chatgptsetupopenchatgpt, local_mcp{{/str}}
        </a>
    </div>
    <div class="mb-4">
        <h3>{{#str}}connectionguideclaudestarttitle, local_mcp{{/str}}</h3>
        <ol>
            <li>{{#str}}connectionguideclaudestep1, local_mcp{{/str}}</li>
            <li>{{#str}}connectionguideclaudestep2, local_mcp{{/str}}</li>
            <li>{{#str}}connectionguideclaudestep3, local_mcp{{/str}}</li>
            <li>{{#str}}connectionguideclaudestep4, local_mcp{{/str}}</li>
        </ol>
        <a href="https://claude.ai/" target="_blank" rel="noopener noreferrer">
            {{#str}}connectionguideopenclaude, local_mcp{{/str}}
        </a>
    </div>
    <p class="mb-0">{{#str}}newconnectionfinish, local_mcp{{/str}}</p>
</section>
