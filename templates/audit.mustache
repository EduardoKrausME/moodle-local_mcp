{{!
    @template local_mcp/audit
    Read-only, escaped audit activity table.
    Example context (json):
    {"rows":[{"time":"2026-10-11","event":"tool_called","side":"write",
      "tool":"create_course","user":"Administrator (#2)","client":"ChatGPT",
      "connection":"3","status":"ok","objects":"{}","requestid":"ab12",
      "duration":"12","confirmation":"Yes","ip":"127.0.0.1"}],"empty":false}
}}
<div class="table-responsive">
    <table class="generaltable table table-striped">
        <thead><tr>
            <th>{{#str}}auditwhen, local_mcp{{/str}}</th>
            <th>{{#str}}auditevent, local_mcp{{/str}}</th>
            <th>{{#str}}auditside, local_mcp{{/str}}</th>
            <th>{{#str}}audittool, local_mcp{{/str}}</th>
            <th>{{#str}}audituser, local_mcp{{/str}}</th>
            <th>{{#str}}auditclient, local_mcp{{/str}}</th>
            <th>{{#str}}auditconnection, local_mcp{{/str}}</th>
            <th>{{#str}}auditstatus, local_mcp{{/str}}</th>
            <th>{{#str}}auditobjects, local_mcp{{/str}}</th>
            <th>{{#str}}auditrequestid, local_mcp{{/str}}</th>
            <th>{{#str}}auditduration, local_mcp{{/str}}</th>
            <th>{{#str}}auditconfirmed, local_mcp{{/str}}</th>
            <th>IP</th>
        </tr></thead>
        <tbody>
        {{#rows}}
            <tr>
                <td>{{time}}</td>
                <td>{{event}}</td>
                <td>{{side}}</td>
                <td><code>{{tool}}</code></td>
                <td>{{user}}</td>
                <td>{{client}}</td>
                <td>{{connection}}</td>
                <td>{{displaystatus}}</td>
                <td><small><code style="white-space:normal;overflow-wrap:anywhere">{{objects}}</code></small></td>
                <td><code>{{requestid}}</code></td>
                <td>{{duration}}</td>
                <td>{{confirmation}}</td>
                <td>{{ip}}</td>
            </tr>
        {{/rows}}
        {{#empty}}<tr><td colspan="13">{{#str}}auditnone, local_mcp{{/str}}</td></tr>{{/empty}}
        </tbody>
    </table>
</div>
