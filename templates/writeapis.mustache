{{!
    @template local_mcp/writeapis

    Example context (json):
    {
        "tables": [
            {
                "pluginname": "Moodle MCP",
                "component": "local_mcp",
                "countlabel": "WRITE tools: 1",
                "rows": [
                    {
                        "name": "create_course",
                        "description": "Create a Moodle course.",
                        "capability": "moodle/course:create",
                        "dryrun": "Yes",
                        "confirmation": "Yes",
                        "destructive": "No"
                    }
                ]
            }
        ],
        "columns": {
            "name": "Name",
            "description": "Description",
            "capability": "Capability",
            "dryrun": "Dry-run",
            "confirmation": "Confirmation",
            "destructive": "Destructive"
        },
        "empty": "No WRITE tools available."
    }
}}
{{#tables}}
    <section class="mb-4" id="local-mcp-{{component}}">
        <h3>{{pluginname}} <small class="text-muted"><code>{{component}}</code></small></h3>
        <p class="text-muted">{{countlabel}}</p>
        <table class="generaltable">
            <thead>
                <tr>
                    <th scope="col">{{columns.name}}</th>
                    <th scope="col">{{columns.description}}</th>
                    <th scope="col">{{columns.capability}}</th>
                    <th scope="col">{{columns.dryrun}}</th>
                    <th scope="col">{{columns.confirmation}}</th>
                    <th scope="col">{{columns.destructive}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td><code>{{name}}</code></td>
                        <td>{{description}}</td>
                        <td><code>{{capability}}</code></td>
                        <td>{{dryrun}}</td>
                        <td>{{confirmation}}</td>
                        <td>{{destructive}}</td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    </section>
{{/tables}}
{{^tables}}
    <p>{{empty}}</p>
{{/tables}}

{{#hasreadonlyplugins}}
    <section class="mt-4" aria-label="{{#str}}writeapisonlyread, local_mcp{{/str}}">
        <h2 class="h3">{{#str}}writeapisonlyread, local_mcp{{/str}}</h2>
        <p class="text-muted">{{#str}}writeapisonlyreadhelp, local_mcp{{/str}}</p>
        {{#readonlyplugins}}
            <section class="mb-4">
                <h3 class="h4">{{pluginname}} <small class="text-muted"><code>{{component}}</code></small></h3>
                <p class="text-muted">{{countlabel}}</p>
                <div class="table-responsive">
                    <table class="generaltable">
                        <thead>
                            <tr>
                                <th scope="col">{{columns.name}}</th>
                                <th scope="col">{{columns.description}}</th>
                                <th scope="col">{{columns.capability}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#rows}}
                                <tr>
                                    <td><code>{{name}}</code></td>
                                    <td>{{description}}</td>
                                    <td><code>{{capability}}</code></td>
                                </tr>
                            {{/rows}}
                        </tbody>
                    </table>
                </div>
                <p><a href="{{{detailsurl}}}">{{#str}}readapisviewall, local_mcp{{/str}}</a> {{more}}</p>
            </section>
        {{/readonlyplugins}}
    </section>
{{/hasreadonlyplugins}}
