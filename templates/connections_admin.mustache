{{!
    @template local_mcp/connections_admin

    Example context (json):
    {
        "rows": [{"id": 1, "user": "Admin", "client": "ChatGPT", "scopes": "mcp:read",
                  "created": "Today", "lastused": "Today"}],
        "hasconnections": true,
        "actionurl": "/local/mcp/admin/connections.php",
        "sesskey": "test"
    }
}}
<section class="mt-4" aria-labelledby="mcp-active-connections-heading">
    <h2 id="mcp-active-connections-heading">{{#str}}connectionactivelist, local_mcp{{/str}}</h2>
    {{#hasconnections}}
        <table class="generaltable">
            <thead><tr>
                <th>{{#str}}connectionuser, local_mcp{{/str}}</th>
                <th>{{#str}}connectionclient, local_mcp{{/str}}</th>
                <th>{{#str}}connectionscopes, local_mcp{{/str}}</th>
                <th>{{#str}}connectioncreated, local_mcp{{/str}}</th>
                <th>{{#str}}connectionlastused, local_mcp{{/str}}</th>
                <th>{{#str}}connectionactions, local_mcp{{/str}}</th>
            </tr></thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{user}}</td>
                        <td>{{client}}</td>
                        <td>{{scopes}}</td>
                        <td>{{created}}</td>
                        <td>{{lastused}}</td>
                        <td>
                            <form method="post" action="{{actionurl}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="revoke">
                                <input type="hidden" name="connectionid" value="{{id}}">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    {{#str}}connectionrevoke, local_mcp{{/str}}
                                </button>
                            </form>
                        </td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    {{/hasconnections}}
    {{^hasconnections}}
        <p>{{#str}}connectionnoneactive, local_mcp{{/str}}</p>
    {{/hasconnections}}
</section>
