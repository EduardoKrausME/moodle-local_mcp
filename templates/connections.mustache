{{!
    @template local_mcp/connections

    A visual reference matching ChatGPT's custom MCP server dialog.
    Registration happens inside ChatGPT, never in this Moodle page.

    Example context (json):
    {
        "mcpserverurl": "https://moodle.example.org/local/mcp/server.php",
        "authorizationserverbase": "https://moodle.example.org/local/mcp/server.php",
        "oauthauthorizeurl": "https://moodle.example.org/local/mcp/oauth/authorize.php",
        "oauthtokenurl": "https://moodle.example.org/local/mcp/oauth/token.php",
        "oauthregisterurl": "https://moodle.example.org/local/mcp/oauth/register.php",
        "discoveryurl": "https://moodle.example.org/local/mcp/oauth-metadata.php",
        "connectionguidenameexample": "Moodle-Example",
        "httpsdisabled": false,
        "showchatgptsetup": true,
        "connectiondocumentationurl": "https://eduardokrausme.github.io/moodle-local_mcp/en/recursos/conexao-chatgpt.html"
    }
}}
<div class="local-mcp-connection-guide"
     data-copy-success="{{#str}}chatgptsetupcopied, local_mcp{{/str}}"
     data-copy-fallback="{{#str}}chatgptsetupcopyfallback, local_mcp{{/str}}">
    <section class="local-mcp-connection-guide__dialog" aria-labelledby="mcp-connection-dialog-title">
        <header class="local-mcp-connection-guide__header">
            <h2 id="mcp-connection-dialog-title">{{#str}}connectionguideformtitle, local_mcp{{/str}}</h2>
            <p>{{#str}}connectionguidepreviewnotice, local_mcp{{/str}}</p>
        </header>

        <div class="local-mcp-connection-guide__body">
            {{^showchatgptsetup}}
                <p class="local-mcp-connection-guide__connected" role="status">
                    {{#str}}connectionguideconnected, local_mcp{{/str}}
                </p>
            {{/showchatgptsetup}}
            {{#httpsdisabled}}
                <p class="local-mcp-connection-guide__warning" role="alert">
                    {{#str}}chatgptsetuphttpsdisabled, local_mcp{{/str}}
                </p>
            {{/httpsdisabled}}

            <div class="local-mcp-connection-guide__field">
                <div class="local-mcp-connection-guide__label">{{#str}}connectionguideicon, local_mcp{{/str}}</div>
                <div class="local-mcp-connection-guide__iconrow">
                    <span class="local-mcp-connection-guide__iconplaceholder" aria-hidden="true">+</span>
                    <span class="local-mcp-connection-guide__hint">{{#str}}connectionguideiconhint, local_mcp{{/str}}</span>
                </div>
            </div>

            <div class="local-mcp-connection-guide__field">
                <label for="mcp-connection-guide-name">{{#str}}connectionguidename, local_mcp{{/str}}</label>
                <input type="text" id="mcp-connection-guide-name" class="form-control"
                       value="{{connectionguidenameexample}}" readonly>
            </div>

            <div class="local-mcp-connection-guide__field">
                <label for="mcp-connection-guide-description">{{#str}}connectionguidedescription, local_mcp{{/str}}</label>
                <input type="text" id="mcp-connection-guide-description" class="form-control"
                       value="{{#str}}connectionguidedescriptionexample, local_mcp{{/str}}" readonly>
            </div>

            <div class="local-mcp-connection-guide__field">
                <div class="local-mcp-connection-guide__fieldheader">
                    <label for="mcp-connection-guide-url">{{#str}}connectionguideconnection, local_mcp{{/str}}</label>
                    <div class="local-mcp-connection-guide__mode" aria-label="{{#str}}connectionguideconnection, local_mcp{{/str}}">
                        <span class="local-mcp-connection-guide__mode-selected">
                            {{#str}}connectionguideurlmode, local_mcp{{/str}}
                        </span>
                        <span class="local-mcp-connection-guide__mode-disabled">
                            {{#str}}connectionguidetunnelmode, local_mcp{{/str}}
                        </span>
                    </div>
                </div>
                <div class="local-mcp-connection-guide__urlrow">
                    <input type="text" id="mcp-connection-guide-url" class="form-control"
                           value="{{mcpserverurl}}" readonly spellcheck="false">
                    <button type="button" class="btn local-mcp-connection-guide__copy"
                            data-action="copy-mcp-url">{{#str}}chatgptsetupcopy, local_mcp{{/str}}</button>
                </div>
                <span class="local-mcp-connection-guide__copy-status" role="status" aria-live="polite"
                      data-role="copy-status"></span>
            </div>

            <div class="local-mcp-connection-guide__field">
                <label for="mcp-connection-guide-auth">{{#str}}connectionguideauthentication, local_mcp{{/str}}</label>
                <input type="text" id="mcp-connection-guide-auth" class="form-control"
                       value="OAuth" readonly>
            </div>

            <details class="local-mcp-connection-guide__advanced">
                <summary>
                    <strong>{{#str}}connectionguideadvanced, local_mcp{{/str}}</strong>
                    <span class="local-mcp-connection-guide__hint">
                        {{#str}}connectionguideadvancedpreview, local_mcp{{/str}}
                    </span>
                    <span class="local-mcp-connection-guide__chevron" aria-hidden="true"></span>
                </summary>
                <div class="local-mcp-connection-guide__advanced-content">
                    <p>{{#str}}connectionguideadvancedhelp, local_mcp{{/str}}</p>
                    <div class="local-mcp-connection-guide__field">
                        <label for="mcp-connection-guide-authorize">{{#str}}connectionguideoauthauthorizeurl, local_mcp{{/str}}</label>
                        <input type="text" id="mcp-connection-guide-authorize" class="form-control"
                               value="{{oauthauthorizeurl}}" readonly spellcheck="false">
                    </div>
                    <div class="local-mcp-connection-guide__field">
                        <label for="mcp-connection-guide-token">{{#str}}connectionguideoauthtokenurl, local_mcp{{/str}}</label>
                        <input type="text" id="mcp-connection-guide-token" class="form-control"
                               value="{{oauthtokenurl}}" readonly spellcheck="false">
                    </div>
                    <div class="local-mcp-connection-guide__field">
                        <label for="mcp-connection-guide-register">{{#str}}connectionguideoauthregisterurl, local_mcp{{/str}}</label>
                        <input type="text" id="mcp-connection-guide-register" class="form-control"
                               value="{{oauthregisterurl}}" readonly spellcheck="false">
                    </div>
                    <div class="local-mcp-connection-guide__field">
                        <label for="mcp-connection-guide-base">{{#str}}connectionguideoauthserverbase, local_mcp{{/str}}</label>
                        <input type="text" id="mcp-connection-guide-base" class="form-control"
                               value="{{authorizationserverbase}}" readonly spellcheck="false">
                    </div>
                    <div class="local-mcp-connection-guide__field">
                        <label for="mcp-connection-guide-resource">{{#str}}connectionguideoauthresource, local_mcp{{/str}}</label>
                        <input type="text" id="mcp-connection-guide-resource" class="form-control"
                               value="{{mcpserverurl}}" readonly spellcheck="false">
                    </div>
                    <p class="local-mcp-connection-guide__discovery">
                        {{#str}}chatgptsetupdiscoveryhelp, local_mcp{{/str}}
                        <code>{{discoveryurl}}</code>
                    </p>
                </div>
            </details>

            <p class="local-mcp-connection-guide__security-note" role="note">
                <span aria-hidden="true">&#9888;</span>
                {{#str}}connectionguiderisknotice, local_mcp{{/str}}
            </p>

            <div class="local-mcp-connection-guide__acknowledgement">
                <span class="local-mcp-connection-guide__checkboxsample" aria-hidden="true"></span>
                <div>
                    <strong>{{#str}}connectionguideacknowledgement, local_mcp{{/str}}</strong>
                    <p>{{#str}}connectionguideacknowledgementhelp, local_mcp{{/str}}</p>
                </div>
            </div>
        </div>

        <footer class="local-mcp-connection-guide__footer">
            <a href="{{{connectiondocumentationurl}}}" target="_blank" rel="noopener noreferrer">
                {{#str}}connectionguidedocumentation, local_mcp{{/str}}
                <span class="sr-only">({{#str}}chatgptsetupnewtab, local_mcp{{/str}})</span>
            </a>
            <a href="https://chatgpt.com/plugins" class="btn local-mcp-connection-guide__open"
               target="_blank" rel="noopener noreferrer">
                {{#str}}chatgptsetupopenchatgpt, local_mcp{{/str}}
                <span class="sr-only">({{#str}}chatgptsetupnewtab, local_mcp{{/str}})</span>
            </a>
        </footer>
    </section>
</div>
{{#js}}
    require(['jquery'], function($) {
        $('.local-mcp-connection-guide [data-action="copy-mcp-url"]').on('click', function() {
            var guide = $(this).closest('.local-mcp-connection-guide');
            var input = guide.find('#mcp-connection-guide-url');
            var status = guide.find('[data-role="copy-status"]');
            function fallback() {
                input.trigger('focus');
                input[0].select();
                status.text(guide.attr('data-copy-fallback'));
            }
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(input.val()).then(function() {
                    status.text(guide.attr('data-copy-success'));
                }, fallback);
            } else {
                fallback();
            }
        });
    });
{{/js}}
