{{!
    @template local_mcp/dashboard

    Example context (json):
    {
        "connections": 2,
        "clients": 1,
        "readtoday": 14,
        "writetoday": 6,
        "writecompletedtoday": 2,
        "destructivetoday": 1,
        "totaltools": 25,
        "hasactivity": true,
        "hasplugins": true,
        "activitychart": "<div>Chart rendered by Moodle</div>",
        "statuschart": "<div>Chart rendered by Moodle</div>",
        "pluginchart": "<div>Chart rendered by Moodle</div>",
        "writeapisurl": "/local/mcp/admin/writeapis.php",
        "readapisurl": "/local/mcp/admin/readapis.php",
        "auditurl": "/local/mcp/admin/audit.php",
        "plugins": [
            {
                "pluginname": "Moodle MCP",
                "component": "local_mcp",
                "tools": 25,
                "dryrun": 20,
                "confirmation": 12,
                "destructive": 3,
                "examples": "create_course, update_course, update_user",
                "more": "+22 more",
                "detailsurl": "/local/mcp/admin/writeapis.php#local-mcp-local_mcp"
            }
        ]
    }
}}
{{> local_mcp/chatgpt_setup}}
<div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
    <div>
        <h3 class="h4 mb-1">{{#str}}dashboardoverview, local_mcp{{/str}}</h3>
        <p class="text-muted mb-2">{{#str}}dashboardtodaydescription, local_mcp{{/str}}</p>
    </div>
    <nav class="d-flex flex-wrap mb-2" aria-label="{{#str}}dashboardquicklinks, local_mcp{{/str}}">
        <a class="btn btn-outline-secondary btn-sm mr-2 mb-2" href="{{readapisurl}}">{{#str}}readapis, local_mcp{{/str}}</a>
        <a class="btn btn-outline-secondary btn-sm mr-2 mb-2" href="{{writeapisurl}}">{{#str}}writeapis, local_mcp{{/str}}</a>
        <a class="btn btn-outline-secondary btn-sm mb-2" href="{{auditurl}}">{{#str}}audit, local_mcp{{/str}}</a>
    </nav>
</div>

<div class="row">
    <div class="col-sm-6 col-xl-4">
        <div class="card mb-3 h-auto">
            <div class="card-body">
                <div class="text-muted">{{#str}}dashboardconnections, local_mcp{{/str}}</div>
                <div class="h2 mb-0">{{connections}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted">{{#str}}dashboardclients, local_mcp{{/str}}</div>
                <div class="h2 mb-0">{{clients}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted">{{#str}}dashboardtotaltools, local_mcp{{/str}}</div>
                <div class="h2 mb-0">{{totaltools}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted">{{#str}}dashboardreadtoday, local_mcp{{/str}}</div>
                <div class="h2 mb-0">{{readtoday}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted">{{#str}}dashboardwritetoday, local_mcp{{/str}}</div>
                <div class="h2 mb-0">{{writetoday}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted">{{#str}}dashboardwritecompletedtoday, local_mcp{{/str}}</div>
                <div class="h2 mb-0">{{writecompletedtoday}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted">{{#str}}dashboarddestructivetoday, local_mcp{{/str}}</div>
                <div class="h2 mb-0">{{destructivetoday}}</div>
            </div>
        </div>
    </div>
</div>

<h3 class="h4 mt-3">{{#str}}dashboardactivityheading, local_mcp{{/str}}</h3>
<p class="text-muted">{{#str}}dashboardactivityhelp, local_mcp{{/str}}</p>
{{#hasactivity}}
    <div class="row">
        <div class="col-lg-8 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="h5">{{#str}}dashboardactivitychart, local_mcp{{/str}}</h4>
                    {{{activitychart}}}
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="h5">{{#str}}dashboardstatuschart, local_mcp{{/str}}</h4>
                    {{{statuschart}}}
                </div>
            </div>
        </div>
    </div>
{{/hasactivity}}
{{^hasactivity}}
    <div class="alert alert-info">{{#str}}dashboardnoactivity, local_mcp{{/str}}</div>
{{/hasactivity}}

<div class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-2">
    <div>
        <h3 class="h4 mb-1">{{#str}}dashboardwritesummary, local_mcp{{/str}}</h3>
        <p class="text-muted mb-0">{{#str}}dashboardwritesummaryhelp, local_mcp{{/str}}</p>
    </div>
    <a href="{{writeapisurl}}" class="btn btn-outline-secondary btn-sm mb-2">{{#str}}dashboardviewall, local_mcp{{/str}}</a>
</div>
{{#hasplugins}}
    <div class="row">
        <div class="col-xl-8 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="generaltable">
                            <thead>
                                <tr>
                                    <th scope="col">{{#str}}dashboardplugin, local_mcp{{/str}}</th>
                                    <th scope="col">{{#str}}dashboardtools, local_mcp{{/str}}</th>
                                    <th scope="col">{{#str}}writeapiscoldryrun, local_mcp{{/str}}</th>
                                    <th scope="col">{{#str}}writeapiscolconfirmation, local_mcp{{/str}}</th>
                                    <th scope="col">{{#str}}writeapiscoldestructive, local_mcp{{/str}}</th>
                                    <th scope="col">{{#str}}dashboardexamples, local_mcp{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#plugins}}
                                    <tr>
                                        <td>
                                            <a href="{{detailsurl}}">{{pluginname}}</a>
                                            <div class="small text-muted"><code>{{component}}</code></div>
                                        </td>
                                        <td>{{tools}}</td>
                                        <td>{{dryrun}}</td>
                                        <td>{{confirmation}}</td>
                                        <td>{{destructive}}</td>
                                        <td class="small"><code>{{examples}}</code> {{more}}</td>
                                    </tr>
                                {{/plugins}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="h5">{{#str}}dashboardpluginschart, local_mcp{{/str}}</h4>
                    {{{pluginchart}}}
                </div>
            </div>
        </div>
    </div>
{{/hasplugins}}
{{^hasplugins}}
    <div class="alert alert-info">{{#str}}writeapisempty, local_mcp{{/str}}</div>
{{/hasplugins}}
